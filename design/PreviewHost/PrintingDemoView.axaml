<UserControl
    Background="{DynamicResource PrintingTools.Surface}"
    Foreground="{DynamicResource PrintingTools.Text}"
    x:Class="TheOne.DesignPreview.PrintingDemoView"
    x:DataType="local:PrintingDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            HorizontalAlignment="Stretch"
            Margin="24"
            MaxWidth="920"
            Spacing="20">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="打印工具 · 三个参数，一次调用"
                TextWrapping="Wrap" />
            <TextBlock Text="1. 选择打印源   2. 设置可选参数   3. 决定是否预览" TextWrapping="Wrap" />
            <StackPanel IsEnabled="{Binding !IsBusy}" Spacing="12">
                <WrapPanel>
                    <Button
                        Command="{Binding DocumentFileCommand}"
                        Content="PDF（单选）"
                        Margin="0,0,8,8"
                        x:Name="DemoDocument" />
                    <Button
                        Command="{Binding SingleFileCommand}"
                        Content="单张图片"
                        Margin="0,0,8,8"
                        x:Name="DemoSingleFile" />
                    <Button
                        Command="{Binding MultipleFilesCommand}"
                        Content="多张图片"
                        Margin="0,0,8,8"
                        x:Name="DemoMultipleFiles" />
                    <Button
                        Command="{Binding VisualCommand}"
                        Content="Visual 视觉树"
                        Margin="0,0,8,8"
                        x:Name="DemoVisual" />
                    <Button
                        Command="{Binding SampleCommand}"
                        Content="分页报表"
                        Margin="0,0,8,8"
                        x:Name="DemoSample" />
                    <Button
                        Command="{Binding MixedCommand}"
                        Content="混合来源"
                        Margin="0,0,8,8"
                        x:Name="DemoMixed" />
                </WrapPanel>
                <TextBlock FontWeight="SemiBold" Text="网络 PDF / 图片" />
                <TextBox
                    AcceptsReturn="True"
                    AutomationProperties.Name="网络打印源地址，每行一个"
                    MaxHeight="180"
                    MinHeight="90"
                    PlaceholderText="每行一个完整的 http:// 或 https:// 地址"
                    Text="{Binding NetworkUrls, Mode=TwoWay}"
                    TextWrapping="Wrap"
                    x:Name="DemoNetworkUrls" />
                <TextBlock Text="PDF 仅一个地址；图片可多个。选择源后点击打印才开始下载，下载期间可取消。" TextWrapping="Wrap" />
                <Button
                    AutomationProperties.Name="使用网络 PDF 或图片源"
                    Command="{Binding NetworkSourceCommand}"
                    Content="使用网络源"
                    HorizontalAlignment="Left"
                    x:Name="DemoNetworkSource" />
                <TextBlock
                    FontSize="18"
                    Text="{Binding Summary}"
                    TextWrapping="Wrap"
                    x:Name="DemoSummary" />
                <TextBlock Text="PDF 单选；PNG / JPEG / BMP / WebP 图片可多选。预览中可选择图片布局、填充、对齐、顺序和间距。Visual 视觉树保持原样；不支持 Word / TXT。" TextWrapping="Wrap" />
                <TextBlock Text="份数（可选，默认 1）" />
                <NumericUpDown
                    AutomationProperties.Name="打印份数"
                    FormatString="0"
                    HorizontalAlignment="Left"
                    Increment="1"
                    MaxWidth="200"
                    Maximum="999"
                    Minimum="1"
                    Value="{Binding Copies, Mode=TwoWay}"
                    x:Name="DemoCopies" />
                <TextBlock Text="打印机 ID（可选，留空使用系统默认设备）" TextWrapping="Wrap" />
                <TextBox
                    AutomationProperties.Name="打印机 ID"
                    PlaceholderText="系统默认打印机"
                    Text="{Binding PrinterId, Mode=TwoWay}"
                    x:Name="DemoPrinterId" />
                <CheckBox
                    Content="先打开预览（默认开启）"
                    IsChecked="{Binding ShowPreview, Mode=TwoWay}"
                    x:Name="DemoShowPreview" />
                <TextBlock Text="关闭预览后，点击打印会直接提交到指定设备或系统默认设备。" TextWrapping="Wrap" />
            </StackPanel>
            <Border
                BorderBrush="{DynamicResource PrintingTools.Line}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="ViewModel 的实际调用" />
                    <TextBlock
                        Text="{Binding CallExample}"
                        TextWrapping="Wrap"
                        x:Name="DemoCallExample" />
                    <TextBlock Text="最简：await Printing.PrintAsync(filePath);" TextWrapping="Wrap" />
                    <TextBlock Text="多文件：await Printing.PrintAsync(filePaths);" TextWrapping="Wrap" />
                    <TextBlock Text="直接打印：await Printing.PrintAsync(filePath, showPreview: false);" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <WrapPanel>
                <Button
                    Command="{Binding PrintCommand}"
                    Content="打印"
                    Margin="0,0,8,8"
                    MinWidth="120"
                    x:Name="DemoPrint" />
                <Button
                    Command="{Binding CancelCommand}"
                    Content="取消操作"
                    Margin="0,0,8,8"
                    x:Name="DemoCancel" />
            </WrapPanel>
            <TextBlock
                Text="{Binding Status}"
                TextWrapping="Wrap"
                x:Name="DemoStatus" />
            <Border
                Background="#E8F3F3"
                HorizontalAlignment="Left"
                Padding="12"
                x:Name="CaptureSample">
                <TextBlock Foreground="#006061" Text="控件快照示例 · 由打印服务捕获" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>