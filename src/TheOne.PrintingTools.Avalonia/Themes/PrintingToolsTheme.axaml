<Styles
    x:Class="TheOne.PrintingTools.Avalonia.PrintingToolsTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.PrintingTools.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:PrintResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <FluentTheme />
    <local:PrintStyles />
</Styles>